/*
 * Emergency Plan Qt - Skeuomorphic Stylesheet
 * Windows 7 / Classic Design Language
 *
 * This stylesheet provides a classic, tactile UI appearance with:
 * - Gradient backgrounds
 * - Beveled buttons with 3D effects
 * - Warm color palette
 * - Visual depth and dimension
 */

/* ============================================================================
 * Global Settings
 * ============================================================================ */

* {
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    font-size: 9pt;
}

QWidget {
    background-color: #f0f0f0;
    color: #202020;
}

/* ============================================================================
 * Main Window
 * ============================================================================ */

QMainWindow {
    background: #f0f0f0;
}

QMainWindow::separator {
    background: #c0c0c0;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background: #a0a0a0;
}

/* ============================================================================
 * Menu Bar
 * ============================================================================ */

QMenuBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8f8,
        stop: 0.5 #f0f0f0,
        stop: 1.0 #e8e8e8
    );
    border-bottom: 1px solid #c0c0c0;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d8e8ff,
        stop: 1.0 #b8d0f0
    );
    border: 1px solid #90b0d0;
}

QMenuBar::item:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #b8d0f0,
        stop: 1.0 #98b8e0
    );
}

/* ============================================================================
 * Menus
 * ============================================================================ */

QMenu {
    background: #f8f8f8;
    border: 1px solid #a0a0a0;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 30px 6px 25px;
    margin: 0 2px;
}

QMenu::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3399ff,
        stop: 1.0 #2277dd
    );
    color: white;
    border-radius: 2px;
}

QMenu::item:disabled {
    color: #a0a0a0;
}

QMenu::separator {
    height: 1px;
    background: #c0c0c0;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    margin-left: 6px;
}

/* ============================================================================
 * Toolbar
 * ============================================================================ */

QToolBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8f8,
        stop: 0.4 #f0f0f0,
        stop: 1.0 #e0e0e0
    );
    border-bottom: 1px solid #b0b0b0;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background: #c0c0c0;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8ff,
        stop: 0.5 #e8f0ff,
        stop: 1.0 #d8e0f0
    );
    border: 1px solid #a0c0e0;
}

QToolButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c8d8f0,
        stop: 0.5 #b8c8e0,
        stop: 1.0 #a8b8d0
    );
    border: 1px solid #8090b0;
}

QToolButton:checked {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d0e0ff,
        stop: 0.5 #c0d0f0,
        stop: 1.0 #b0c0e0
    );
    border: 1px solid #8090c0;
}

/* ============================================================================
 * Push Buttons
 * ============================================================================ */

QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8f8,
        stop: 0.4 #f0f0f0,
        stop: 0.5 #e8e8e8,
        stop: 1.0 #e0e0e0
    );
    border: 1px solid #a0a0a0;
    border-radius: 3px;
    padding: 5px 16px;
    min-height: 20px;
    min-width: 75px;
}

QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8ff,
        stop: 0.4 #e8f0ff,
        stop: 0.5 #d8e8ff,
        stop: 1.0 #c8d8f0
    );
    border: 1px solid #6090c0;
}

QPushButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d0d0d0,
        stop: 0.4 #d8d8d8,
        stop: 0.5 #e0e0e0,
        stop: 1.0 #e8e8e8
    );
    border: 1px solid #808080;
    padding-top: 6px;
    padding-bottom: 4px;
}

QPushButton:disabled {
    background: #e8e8e8;
    border: 1px solid #c0c0c0;
    color: #a0a0a0;
}

QPushButton:default {
    border: 2px solid #5080c0;
}

/* Primary action button (use with class or object name) */
QPushButton[primary="true"], QPushButton#primaryButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #5599ee,
        stop: 0.4 #4488dd,
        stop: 0.5 #3377cc,
        stop: 1.0 #2266bb
    );
    border: 1px solid #2266aa;
    color: white;
}

QPushButton[primary="true"]:hover, QPushButton#primaryButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #66aaff,
        stop: 0.4 #5599ee,
        stop: 0.5 #4488dd,
        stop: 1.0 #3377cc
    );
}

/* ============================================================================
 * Line Edits
 * ============================================================================ */

QLineEdit {
    background: white;
    border: 1px solid #a0a0a0;
    border-radius: 2px;
    padding: 4px 6px;
    selection-background-color: #3399ff;
    selection-color: white;
}

QLineEdit:focus {
    border: 1px solid #3399ff;
}

QLineEdit:disabled {
    background: #f0f0f0;
    color: #a0a0a0;
}

QLineEdit:read-only {
    background: #f8f8f8;
}

/* ============================================================================
 * Text Edits
 * ============================================================================ */

QTextEdit, QPlainTextEdit {
    background: white;
    border: 1px solid #a0a0a0;
    border-radius: 2px;
    padding: 2px;
    selection-background-color: #3399ff;
    selection-color: white;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3399ff;
}

/* ============================================================================
 * Spin Boxes
 * ============================================================================ */

QSpinBox, QDoubleSpinBox {
    background: white;
    border: 1px solid #a0a0a0;
    border-radius: 2px;
    padding: 2px 4px;
    padding-right: 20px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3399ff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #c0c0c0;
    border-bottom: 1px solid #c0c0c0;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #e0e0e0
    );
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #c0c0c0;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #e0e0e0
    );
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f0ff,
        stop: 1 #d0e0f0
    );
}

/* ============================================================================
 * Combo Boxes
 * ============================================================================ */

QComboBox {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8f8,
        stop: 1 #e8e8e8
    );
    border: 1px solid #a0a0a0;
    border-radius: 2px;
    padding: 3px 6px;
    padding-right: 20px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #6090c0;
}

QComboBox:focus {
    border: 1px solid #3399ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #c0c0c0;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
}

QComboBox::drop-down:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f0ff,
        stop: 1 #d0e0f0
    );
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #a0a0a0;
    selection-background-color: #3399ff;
    selection-color: white;
}

/* ============================================================================
 * Group Boxes
 * ============================================================================ */

QGroupBox {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff,
        stop: 1.0 #f4f4f4
    );
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    left: 10px;
    background: #f0f0f0;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
}

/* ============================================================================
 * Tab Widget
 * ============================================================================ */

QTabWidget::pane {
    border: 1px solid #c0c0c0;
    background: #f8f8f8;
    top: -1px;
}

QTabBar::tab {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
    border: 1px solid #c0c0c0;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #f8f8f8;
    border-bottom: 1px solid #f8f8f8;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8ff,
        stop: 1 #e8f0f8
    );
}

/* ============================================================================
 * List View
 * ============================================================================ */

QListView {
    background: white;
    border: 1px solid #a0a0a0;
    alternate-background-color: #f5f5f5;
    show-decoration-selected: 1;
}

QListView::item {
    padding: 4px;
    border-bottom: 1px solid #e8e8e8;
}

QListView::item:hover {
    background: #e8f0ff;
}

QListView::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3399ff,
        stop: 1 #2277dd
    );
    color: white;
}

QListView::item:selected:!active {
    background: #a0a0a0;
}

/* ============================================================================
 * Tree View
 * ============================================================================ */

QTreeView {
    background: white;
    border: 1px solid #a0a0a0;
    alternate-background-color: #f8f8f8;
    show-decoration-selected: 1;
}

QTreeView::item {
    padding: 2px;
}

QTreeView::item:hover {
    background: #e8f0ff;
}

QTreeView::item:selected {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3399ff,
        stop: 1 #2277dd
    );
    color: white;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/branch-closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/branch-open.png);
}

/* ============================================================================
 * Table View
 * ============================================================================ */

QTableView {
    background: white;
    border: 1px solid #a0a0a0;
    gridline-color: #e0e0e0;
    alternate-background-color: #f8f8f8;
}

QTableView::item:selected {
    background: #3399ff;
    color: white;
}

QHeaderView::section {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8f8,
        stop: 1 #e0e0e0
    );
    border: none;
    border-right: 1px solid #c0c0c0;
    border-bottom: 1px solid #c0c0c0;
    padding: 4px 6px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8f8ff,
        stop: 1 #e8f0f8
    );
}

/* ============================================================================
 * Scroll Bars
 * ============================================================================ */

QScrollBar:vertical {
    background: #f0f0f0;
    width: 17px;
    margin: 17px 0 17px 0;
    border: 1px solid #c0c0c0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #e8e8e8,
        stop: 0.5 #d8d8d8,
        stop: 1 #e8e8e8
    );
    min-height: 30px;
    border: 1px solid #b0b0b0;
    border-radius: 2px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #d8e8ff,
        stop: 0.5 #c8d8f0,
        stop: 1 #d8e8ff
    );
    border: 1px solid #8090c0;
}

QScrollBar::add-line:vertical {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
    height: 16px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    border: 1px solid #c0c0c0;
}

QScrollBar::sub-line:vertical {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
    height: 16px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    border: 1px solid #c0c0c0;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 17px;
    margin: 0 17px 0 17px;
    border: 1px solid #c0c0c0;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8e8e8,
        stop: 0.5 #d8d8d8,
        stop: 1 #e8e8e8
    );
    min-width: 30px;
    border: 1px solid #b0b0b0;
    border-radius: 2px;
    margin: 1px;
}

QScrollBar::add-line:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
    width: 16px;
    subcontrol-position: right;
    subcontrol-origin: margin;
    border: 1px solid #c0c0c0;
}

QScrollBar::sub-line:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #f0f0f0,
        stop: 1 #d8d8d8
    );
    width: 16px;
    subcontrol-position: left;
    subcontrol-origin: margin;
    border: 1px solid #c0c0c0;
}

/* ============================================================================
 * Splitter
 * ============================================================================ */

QSplitter::handle {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #e0e0e0,
        stop: 0.5 #d0d0d0,
        stop: 1 #e0e0e0
    );
}

QSplitter::handle:horizontal {
    width: 5px;
}

QSplitter::handle:vertical {
    height: 5px;
}

QSplitter::handle:hover {
    background: #b0c0d0;
}

/* ============================================================================
 * Status Bar
 * ============================================================================ */

QStatusBar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8e8e8,
        stop: 1 #d8d8d8
    );
    border-top: 1px solid #b0b0b0;
}

QStatusBar::item {
    border: none;
}

/* ============================================================================
 * Progress Bar
 * ============================================================================ */

QProgressBar {
    background: white;
    border: 1px solid #a0a0a0;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #60c060,
        stop: 0.5 #40a040,
        stop: 1 #60c060
    );
    border-radius: 2px;
    margin: 1px;
}

/* ============================================================================
 * Check Box & Radio Button
 * ============================================================================ */

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked {
    background: white;
    border: 1px solid #a0a0a0;
    border-radius: 2px;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #6090c0;
}

QCheckBox::indicator:checked {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #4488dd,
        stop: 1 #3377cc
    );
    border: 1px solid #2266aa;
    border-radius: 2px;
    image: url(:/icons/check.png);
}

QRadioButton::indicator {
    border-radius: 8px;
}

QRadioButton::indicator:unchecked {
    background: white;
    border: 1px solid #a0a0a0;
}

QRadioButton::indicator:checked {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #3377cc,
        stop: 0.6 #3377cc,
        stop: 0.7 white,
        stop: 1 white
    );
    border: 1px solid #2266aa;
}

/* ============================================================================
 * Slider
 * ============================================================================ */

QSlider::groove:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c0c0c0,
        stop: 0.5 #e0e0e0,
        stop: 1 #c0c0c0
    );
    border: 1px solid #a0a0a0;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f0f0,
        stop: 0.5 #e0e0e0,
        stop: 1 #d0d0d0
    );
    border: 1px solid #a0a0a0;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f0ff,
        stop: 0.5 #d0e0f0,
        stop: 1 #c0d0e0
    );
    border: 1px solid #6090c0;
}

/* ============================================================================
 * Tooltips
 * ============================================================================ */

QToolTip {
    background: #ffffcc;
    border: 1px solid #c0c080;
    padding: 4px;
    color: #202020;
}

/* ============================================================================
 * Dialog Buttons
 * ============================================================================ */

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}
